# --- App ---
# Host port Nextcloud will be reachable on: http://<pi-ip>:APP_PORT
APP_PORT=8080

# Pin an explicit Nextcloud major version (check hub.docker.com/_/nextcloud
# for the current stable tag). Never float ":apache" alone -- Nextcloud
# cannot skip major versions on upgrade, and a floating tag can silently
# jump majors on redeploy and break the instance.
NEXTCLOUD_IMAGE_TAG=30-apache

# Space-separated list of domains/IPs allowed to access this instance.
# Re-applied automatically on every container start.
# Example: NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com 192.168.1.50
NEXTCLOUD_TRUSTED_DOMAINS=

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_generate_a_strong_password

# --- Storage ---
# Host path where the USB HDD is mounted -- this is what decides which
# disk Nextcloud stores user files on. Bind-mounted straight into the
# container's data directory. To move to a different disk later, mount
# it, chown it to 33:33, update this value, and redeploy -- no compose
# edits needed.
NEXTCLOUD_DATA_DIR_HOST=/mnt/nas-hdd/nextcloud-data

# --- PostgreSQL ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change_me_generate_a_strong_password

# --- Redis ---
REDIS_PASSWORD=change_me_generate_a_strong_password
