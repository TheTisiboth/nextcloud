# --- App ---
# Host port Nextcloud will be reachable on: http://<pi-ip>:APP_PORT
APP_PORT=8080

# Float on a major tag (NN-apache): every Deploy pulls the newest patch/minor
# of that major (pull_policy: always). Never use "apache" or "latest" --
# Nextcloud cannot skip major versions, so bump this one major at a time.
# See README "Updating".
NEXTCLOUD_IMAGE_TAG=34-apache

# Space-separated list of domains/IPs allowed to access this instance.
# Re-applied automatically on every container start.
# Example: NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com 192.168.1.50
NEXTCLOUD_TRUSTED_DOMAINS=cloud.leojan.fr

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_generate_a_strong_password

# --- Reverse proxy (Dokploy/Traefik) ---
# These force Nextcloud to generate https:// links for this domain, so
# only fill them in (or redeploy with them set) once the domain is
# actually added and routing in Dokploy's Domains tab -- setting them
# before that's live will break direct http://<pi-ip>:APP_PORT access.
# Applied automatically via config/proxy.config.php, no manual occ
# commands needed. Leave all four blank for plain LAN/IP access.
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://cloud.leojan.fr
OVERWRITEHOST=cloud.leojan.fr
# CIDR of Dokploy's internal network (find it with:
# docker network inspect dokploy-network | grep Subnet)
TRUSTED_PROXIES=

# --- Storage ---
# Host path where the USB HDD is mounted -- this is what decides which
# disk Nextcloud stores user files on. Bind-mounted straight into the
# container's data directory. To move to a different disk later, mount
# it, chown it to 33:33, update this value, and redeploy -- no compose
# edits needed.
NEXTCLOUD_DATA_DIR_HOST=/mnt/nas-hdd/nextcloud-data

# --- PostgreSQL ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change_me_generate_a_strong_password

# --- Redis ---
REDIS_PASSWORD=change_me_generate_a_strong_password

# --- Email (SMTP) ---
# Gmail with an app password -- see README "Email (Gmail SMTP)".
# Read at runtime by the image's smtp.config.php; leave SMTP_HOST blank to
# disable. Mail settings in the admin UI are overridden while these are set.
SMTP_HOST=smtp.gmail.com
SMTP_SECURE=ssl
SMTP_PORT=465
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=you@gmail.com
SMTP_PASSWORD=change_me_16_char_app_password
# Local part only: "you" for you@gmail.com
MAIL_FROM_ADDRESS=you
MAIL_DOMAIN=gmail.com
